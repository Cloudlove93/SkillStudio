# EduSkill local environment template
#
# Copy this file to .env.local for local development.
# Do not commit real secrets.

# Database
POSTGRES_DB=educlawlite
POSTGRES_USER=educlawlite
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=5435
DATABASE_URL=postgres://educlawlite:local-dev-password@educlaw-db:5432/educlawlite

# Authentication service runs in auth-service/docker-compose.yml.
AUTH_UPSTREAM=http://auth-backend:3000
AUTH_NETWORK_NAME=auth-service_internal-net
APP_ORIGIN=http://app.localhost
NODE_ENV=development
LOG_LEVEL=info

# LLM
# External provider settings: fill these before using Skill generation/testing.
# Keep multimodal model names blank unless the selected provider supports them.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_BASELINE_MODEL=
# Pi Core for Skill Run/Test agent-mode enhanced answers (default on).
PI_HARNESS_SKILL_RUN_ENABLED=true
PI_HARNESS_MAX_CONCURRENT_RUNS=4
PI_HARNESS_RUN_TIMEOUT_MS=300000
ARENA_RUN_STREAM_HEARTBEAT_MS=15000
MULTIMODAL_ADLER_MODEL=
MULTIMODAL_CANDIDATE_MODEL=
MULTIMODAL_VALIDATION_MODEL=
MULTIMODAL_RIA_MODEL=
MULTIMODAL_VISION_MODEL=
MULTIMODAL_MODEL_MAX_TOKENS=8192
MULTIMODAL_ASR_CHUNK_DURATION_MS=1200000
MULTIMODAL_UPLOAD_MAX_MB=1024
MULTIMODAL_SINGLE_PUT_MAX_MB=256
MULTIMODAL_MULTIPART_PART_MB=64
MEDIA_UPLOAD_TOKEN_SECRET=replace-with-local-dev-upload-token-secret
MULTIMODAL_PIPELINE_RUNNER_ENABLED=false
MULTIMODAL_PIPELINE_RUNNER_POLL_INTERVAL_MS=15000
MULTIMODAL_PIPELINE_RUNNER_BATCH_LIMIT=8
MULTIMODAL_PIPELINE_RUNNER_CONCURRENCY=2

# Service ports
SERVER_PORT=3000
WEB_PORT=80

# Object storage (local example placeholders)
# Must resolve from both the browser and Docker containers for presigned URLs.
OBJECT_STORAGE_ENDPOINT=http://app.localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=educlaw-media
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-local-dev-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-local-dev-secret-key
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300

# Local MinIO. Completed objects have no TTL/lifecycle deletion policy.
MINIO_ROOT_USER=replace-with-local-dev-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-dev-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Internal Worker API. Use the same token value on both lines; rotate for production.
INTERNAL_WORKER_TOKENS=replace-with-local-dev-worker-token
MEDIA_WORKER_BASE_URL=http://educlaw-server:3000/api
MEDIA_WORKER_SERVICE_TOKEN=replace-with-local-dev-worker-token
MEDIA_WORKER_MAX_DURATION_MS=43200000
MEDIA_WORKER_HEARTBEAT_INTERVAL_SECONDS=15
MEDIA_WORKER_POLL_INTERVAL_SECONDS=2
MEDIA_WORKER_MAX_IDLE_POLL_INTERVAL_SECONDS=30
MEDIA_WORKER_REQUEST_TIMEOUT_SECONDS=15

# Local segmented ASR used by distillation workers.
MEDIA_WORKER_ASR_MODEL=small
MEDIA_WORKER_ASR_MANIFEST_MODEL_ID=faster-whisper-small
MEDIA_WORKER_ASR_DEVICE=cpu
MEDIA_WORKER_ASR_COMPUTE_TYPE=int8
MEDIA_WORKER_ASR_LANGUAGE=zh
MEDIA_WORKER_ASR_BEAM_SIZE=3
# 一次生成同时提供 Agent 与 Skill；关闭后仍可读取历史记录。
GENERATION_AGENT_ENABLED=true
