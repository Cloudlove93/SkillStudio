# ============================================
# EduClaw Lite Arena - 生产环境配置模板
# ============================================

# --- 数据库 ---
POSTGRES_DB=educlawlite
POSTGRES_USER=educlawlite
POSTGRES_PASSWORD=your-strong-password-here
POSTGRES_PORT=5435
DATABASE_URL=postgres://educlawlite:your-strong-password-here@educlaw-postgres:5432/educlawlite

# --- JWT 密钥（生产环境必须修改）---
JWT_SECRET=change-this-to-a-random-long-string

# --- 初始账号（公网生产默认关闭；如需预置账号，必须设置强密码）---
SEED_USERS=false
SEED_USER_NAMES=user1,user2,user3,user4,user5
SEED_USER_PASSWORD=replace-with-a-strong-password

# --- LLM API 配置（必填）---
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=kimi-k2.6
LLM_BASELINE_MODEL=kimi-k2.6

# --- 服务端口 ---
SERVER_PORT=3000
WEB_PORT=80

# --- 前端来源（CORS 白名单）---
APP_ORIGIN=http://localhost
