# EduSkill local environment template
#
# Copy this file to .env.local for local development.
# Do not commit real secrets.

# Database
POSTGRES_DB=educlawlite
POSTGRES_USER=educlawlite
POSTGRES_PASSWORD=local-dev-password
POSTGRES_PORT=5435
DATABASE_URL=postgres://educlawlite:local-dev-password@educlaw-postgres:5432/educlawlite

# Auth
JWT_SECRET=local-dev-jwt-secret-not-for-production
INVITE_CODE=EduSkill2026

# Optional seeded accounts for local development
SEED_USERS=false
SEED_USER_NAMES=user1,user2,user3,user4,user5
SEED_USER_PASSWORD=local-dev-seed-password-not-for-production

# LLM
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL=kimi-k2.6
LLM_BASELINE_MODEL=kimi-k2.6

# Service ports
SERVER_PORT=3000
WEB_PORT=80

# Front-end origin for CORS
APP_ORIGIN=http://eduskill.localhost
