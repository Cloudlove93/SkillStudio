KONG_PROXY_PORT=8080
KONG_ADMIN_PORT=8001
KONG_APP_HOST=app.localhost
KONG_AUTH_HOST=auth.localhost
KONG_EDUNEX_HOST=edunex.localhost
PG_PORT=5434
ZITADEL_VERSION=v4.13.1
ZITADEL_MASTERKEY=replace-with-exactly-32-characters
ZITADEL_DB_PASSWORD=replace-with-a-strong-password
ZITADEL_ADMIN_PASSWORD=replace-with-a-strong-password
ZITADEL_CLIENT_ID=
ZITADEL_PROJECT_ID=
ZITADEL_DEFAULT_ROLE_KEY=EduClaw

# 生产环境可将宿主机端口仅绑定到本机回环地址，再由宿主机 Nginx 统一接管 80/443。
# 例如：
# KONG_PROXY_PORT=127.0.0.1:8080
# KONG_ADMIN_PORT=127.0.0.1:8001
# PG_PORT=127.0.0.1:5432

# ─── Zitadel OIDC 配置 ───────────────────────────────────────────────────────
ZITADEL_ISSUER=http://auth.localhost:8080
# Keep the public Host header when containers call Zitadel through Kong.
ZITADEL_INTERNAL_ISSUER=http://auth.localhost
# auth-backend uses the local IAM admin PAT from the bootstrap volume.
# ZITADEL_SERVICE_PAT_FILE=/zitadel/bootstrap/admin.pat
# The login client PAT is required to complete OIDC authorization requests.
# ZITADEL_LOGIN_CLIENT_PAT_FILE=/zitadel/bootstrap/login-client.pat
ZITADEL_LOGIN_REDIRECT_URI=http://auth.localhost:8080/auth/callback

# ─── 阿里云短信配置 ─────────────────────────────────────────────────────────
# 获取方式：阿里云控制台 → AccessKey 管理
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 短信签名名称（需在阿里云控制台申请并通过审核）
ALIYUN_SMS_SIGN_NAME=
# 短信模板 Code（需在阿里云控制台创建并通过审核，模板需包含 ${code} 变量）
ALIYUN_SMS_TEMPLATE_CODE=

# ─── 前端配置 ───────────────────────────────────────────────────────────────
# Docker 部署时前端 API 基础 URL（留空则由 Nginx 代理）
VITE_API_BASE=

# ─── EduNex 业务服务配置 ───────────────────────────────────────────────────
EDUNEX_PG_PORT=5434
EDUNEX_POSTGRES_DB=edunex
EDUNEX_POSTGRES_USER=edunex
EDUNEX_POSTGRES_PASSWORD=edunex
EDUNEX_DB_PUSH_ON_START=1
EDUNEX_OAH_WORKSPACE_HOST_ROOT=/Users/almonster/.openagentharness/workspaces
EDUNEX_OAH_WORKSPACE_CONTAINER_ROOT=/mnt/oah-workspaces
AUTH_SECURE_COOKIES=false
